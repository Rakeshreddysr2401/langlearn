# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- API security ---
# Comma-separated list of accepted API keys. Leave empty to disable auth (dev only).
API_KEYS=
# Comma-separated list of allowed frontend origins for CORS.
CORS_ALLOW_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30

# --- LLM provider ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Only needed if using the ollama provider with a remote host.
OLLAMA_HOST=localhost:11434

# --- Memory / checkpointing ---
# If unset, falls back to a non-persistent in-memory checkpointer.
REDIS_URL=

# --- Vector store (RAG knowledge base) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Tools ---
TAVILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Observability (optional) ---
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
